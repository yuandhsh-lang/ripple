* text=auto
*.png binary
*.jpg binary
# Historical patches include unchanged whitespace by design.
docs/hackathon/evidence/*.diff -whitespace

# Preserve the checked delivery bytes, including its CRLF line endings.
/bundle/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Preserve the digest-checked development bundle bytes across Git checkouts.
/stage1/bundle/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Retain historical experiment source bytes; packaging happens in local copies.
/phase1/probe*/bundle/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/phase2/readonly-prep/bundle/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
